<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>Cloud TV finds your other devices on the local network to move a game between iPad and Apple TV.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_cloudtv._tcp</string>
		<string>_cloudtvpad._udp</string>
	</array>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>TVTopShelfImage</key>
	<dict>
		<key>TVTopShelfPrimaryImageWide</key>
		<string>Top Shelf Image Wide</string>
	</dict>
	<key>NSCameraUsageDescription</key>
	<string>CloudNow does not use the camera. This string is required because a linked SDK references camera APIs.</string>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>com.owenselles.CloudNow.tokenRefresh</string>
	</array>
	<key>GCSupportedGameControllers</key>
	<array>
		<dict>
			<key>ProfileName</key>
			<string>ExtendedGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>MicroGamepad</string>
		</dict>
		<dict>
			<key>ProfileName</key>
			<string>DirectionalGamepad</string>
		</dict>
	</array>
</dict>
</plist>
